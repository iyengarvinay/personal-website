---
import BaseLayout from '../layouts/BaseLayout.astro';
import VennMark from '../components/VennMark.astro';
---
<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <div class="not-found">
    <VennMark size={72} spin />
    <p class="eyebrow">404</p>
    <h1>Not every set has an intersection.</h1>
    <p class="sub">This page doesn&rsquo;t exist &mdash; it may have moved, or the link's just wrong.</p>
    <div class="links">
      <a href="/">Back to all essays</a>
      <span class="sep">&middot;</span>
      <a href="/about/">About</a>
      <span class="sep">&middot;</span>
      <a href="/theses/">Theses</a>
      <span class="sep">&middot;</span>
      <a href="/job-guide/">Job Guide</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
    padding: 5rem 1rem 6rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0.5rem 0 0;
  }
  h1 {
    max-width: 32rem;
    margin: 0;
  }
  .sub {
    color: var(--ink-soft);
    max-width: 28rem;
    margin: 0;
  }
  .links {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .links a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
  .sep {
    color: var(--line);
    margin: 0 0.5rem;
  }
</style>
