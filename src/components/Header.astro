---
import VennMark from './VennMark.astro';

const nav = [
  { href: '/', label: 'Essays' },
  { href: '/about/', label: 'About' },
  { href: '/theses/', label: 'Theses' },
  { href: '/job-guide/', label: 'Job Guide' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand">
      <VennMark size={30} spin />
      <span class="brand-name">The Vin Diagram</span>
    </a>
    <p class="tagline">at the intersection of technology, investing, and policy</p>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: 2.5rem 0 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .tagline {
    margin: 0.3rem 0 1.25rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-soft);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover, nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
</style>
