---
import CategoryVenn from './CategoryVenn.astro';
import ArchiveCalendar from './ArchiveCalendar.astro';
---
<aside class="sidebar">
  <div class="widget">
    <div id="search" class="search-box" data-pagefind-ui></div>
  </div>

  <div class="widget">
    <h3 class="eyebrow">Categories</h3>
    <CategoryVenn />
  </div>

  <div class="widget">
    <h3 class="eyebrow">Archives</h3>
    <ArchiveCalendar />
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .widget h3 {
    margin: 0 0 0.75rem;
  }
  .widget ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .widget a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .widget a:hover { color: var(--accent); }
  .count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
