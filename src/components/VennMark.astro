---
interface Props {
  size?: number;
  spin?: boolean;
}
const { size = 22, spin = false } = Astro.props;
---
<svg
  class:list={["venn-mark", { spin }]}
  width={size}
  height={size}
  viewBox="0 0 44 40"
  fill="none"
  aria-hidden="true"
>
  <circle class="c1" cx="17" cy="16" r="13" fill="var(--circle-a)" opacity="0.82"/>
  <circle class="c2" cx="27" cy="16" r="13" fill="var(--circle-b)" opacity="0.82"/>
  <circle class="c3" cx="22" cy="26" r="13" fill="var(--circle-c)" opacity="0.82"/>
</svg>

<style>
  .venn-mark {
    display: inline-block;
    vertical-align: -4px;
    mix-blend-mode: multiply;
    cursor: pointer;
  }
  .venn-mark.spin {
    animation: venn-spin 1.6s linear infinite;
  }
  @keyframes venn-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Dark backgrounds invert multiply's usual darkening effect into mush, so
     screen the (lighter) dark-mode circle fills instead to keep the overlap visible. */
  :global([data-theme="dark"]) .venn-mark {
    mix-blend-mode: screen;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .venn-mark {
      mix-blend-mode: screen;
    }
  }

  /* Easter egg: triple-click bursts the three circles apart (with a pop of
     scale) and springs them back, plus a confetti particle pop (see script) */
  .venn-mark.burst .c1 { animation: burst-c1 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .venn-mark.burst .c2 { animation: burst-c2 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .venn-mark.burst .c3 { animation: burst-c3 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes burst-c1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40% { transform: translate(-11px, -9px) scale(1.2); }
  }
  @keyframes burst-c2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40% { transform: translate(11px, -9px) scale(1.2); }
  }
  @keyframes burst-c3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40% { transform: translate(0, 13px) scale(1.2); }
  }

  /* Dynamically created by the click script and appended outside this
     component's own markup, so it needs :global() to actually match —
     Astro's scope attribute is only stamped onto this file's own template. */
  :global(.venn-particle) {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    pointer-events: none;
    animation: venn-particle-fly 0.7s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  @keyframes venn-particle-fly {
    0% { transform: translate(0, 0) scale(1); opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var PARTICLE_COLORS = ['--circle-a', '--circle-b', '--circle-c'];

    function spawnConfetti(mark) {
      var parent = mark.parentElement;
      if (!parent) return;
      if (getComputedStyle(parent).position === 'static') {
        parent.style.position = 'relative';
      }
      var markBox = mark.getBoundingClientRect();
      var parentBox = parent.getBoundingClientRect();
      var cx = markBox.left - parentBox.left + markBox.width / 2;
      var cy = markBox.top - parentBox.top + markBox.height / 2;
      var count = 12;
      for (var i = 0; i < count; i++) {
        var angle = (Math.PI * 2 * i) / count + Math.random() * 0.4;
        var dist = 22 + Math.random() * 20;
        var dx = Math.cos(angle) * dist;
        var dy = Math.sin(angle) * dist;
        var dot = document.createElement('span');
        dot.className = 'venn-particle';
        dot.style.left = cx + 'px';
        dot.style.top = cy + 'px';
        dot.style.background = 'var(' + PARTICLE_COLORS[i % PARTICLE_COLORS.length] + ')';
        dot.style.setProperty('--dx', dx + 'px');
        dot.style.setProperty('--dy', dy + 'px');
        parent.appendChild(dot);
        (function (el) {
          setTimeout(function () {
            el.remove();
          }, 750);
        })(dot);
      }
    }

    document.querySelectorAll('.venn-mark').forEach(function (mark) {
      var clickTimes = [];
      var navTimer = null;
      // The mark usually sits inside a link (the site logo). We can't know a
      // click is the 1st of a triple-click burst until later clicks arrive,
      // so every click is held for a beat before its default navigation runs
      // — long enough to catch a fast triple-click, short enough not to be
      // noticeable as a delay on an ordinary single click.
      mark.addEventListener('click', function (event) {
        var link = mark.closest('a');
        if (link) event.preventDefault();

        var now = Date.now();
        clickTimes.push(now);
        clickTimes = clickTimes.filter(function (t) {
          return now - t < 600;
        });
        if (navTimer) clearTimeout(navTimer);

        if (clickTimes.length >= 3) {
          clickTimes = [];
          mark.classList.remove('burst');
          // Force reflow so re-adding the class restarts the animation.
          void mark.offsetWidth;
          mark.classList.add('burst');
          spawnConfetti(mark);
          setTimeout(function () {
            mark.classList.remove('burst');
          }, 650);
          return;
        }

        if (link) {
          navTimer = setTimeout(function () {
            window.location.href = link.href;
          }, 350);
        }
      });
    });
  });
</script>
