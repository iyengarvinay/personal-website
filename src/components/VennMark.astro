---
interface Props {
  size?: number;
  spin?: boolean;
}
const { size = 22, spin = false } = Astro.props;
---
<svg
  class:list={["venn-mark", { spin }]}
  width={size}
  height={size}
  viewBox="0 0 44 40"
  fill="none"
  aria-hidden="true"
>
  <circle cx="17" cy="16" r="13" fill="var(--circle-a)" opacity="0.82"/>
  <circle cx="27" cy="16" r="13" fill="var(--circle-b)" opacity="0.82"/>
  <circle cx="22" cy="26" r="13" fill="var(--circle-c)" opacity="0.82"/>
</svg>

<style>
  .venn-mark {
    display: inline-block;
    vertical-align: -4px;
    mix-blend-mode: multiply;
  }
  .venn-mark.spin:hover,
  :global(.brand:hover) .venn-mark.spin {
    animation: venn-spin 1.6s linear infinite;
  }
  @keyframes venn-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
