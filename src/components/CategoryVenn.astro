---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const categoryCounts = new Map<string, number>();
for (const p of posts) {
  for (const c of p.data.categories) {
    categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  }
}

// Fixed circle assignment so colors always match the tag styling and the
// header's spinning mark, regardless of which categories exist. Label
// anchors sit just outside each circle's own edge, on the page background,
// so the label text stays legible in both themes without fighting the
// diagram's multiply/screen blend mode.
const CIRCLES = [
  { name: 'Investing', cx: 71, cy: 73, colorVar: '--circle-a', labelX: 6, labelY: 20, anchor: 'start' },
  { name: 'Policy', cx: 101, cy: 73, colorVar: '--circle-b', labelX: 164, labelY: 20, anchor: 'end' },
  { name: 'Technology', cx: 86, cy: 103, colorVar: '--circle-c', labelX: 86, labelY: 158, anchor: 'middle' },
];
const circles = CIRCLES.map((c) => ({ ...c, count: categoryCounts.get(c.name) ?? 0 })).filter(
  (c) => c.count > 0
);
---
<div class="category-venn">
  <svg viewBox="0 0 170 165" width="100%" role="img" aria-label="Post categories">
    {circles.map((c) => (
      <a href={`/category/${c.name.toLowerCase()}/`} class="venn-cat" aria-label={`${c.name} (${c.count})`}>
        <circle cx={c.cx} cy={c.cy} r="39" fill={`var(${c.colorVar})`} opacity="0.82" />
        <text x={c.labelX} y={c.labelY} text-anchor={c.anchor} fill={`var(${c.colorVar})`}>
          {c.name}
          <tspan class="count-tspan"> {c.count}</tspan>
        </text>
      </a>
    ))}
  </svg>
</div>

<style>
  .category-venn svg {
    mix-blend-mode: multiply;
  }
  :global([data-theme='dark']) .category-venn svg {
    mix-blend-mode: screen;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .category-venn svg {
      mix-blend-mode: screen;
    }
  }
  .venn-cat circle {
    transition: opacity 0.15s ease, transform 0.15s ease;
    transform-origin: center;
    transform-box: fill-box;
  }
  .venn-cat text {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    transition: opacity 0.15s ease;
  }
  .count-tspan {
    font-weight: 400;
    opacity: 0.65;
  }
  .venn-cat:hover circle,
  .venn-cat:focus-visible circle {
    opacity: 1;
    transform: scale(1.04);
  }
  .venn-cat:hover text,
  .venn-cat:focus-visible text {
    text-decoration: underline;
  }
</style>
