---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const categoryCounts = new Map<string, number>();
for (const p of posts) {
  for (const c of p.data.categories) {
    categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  }
}

// Fixed circle assignment so colors always match the tag styling and the
// header's spinning mark, regardless of which categories exist.
const CIRCLES = [
  { name: 'Investing', cx: 51, cy: 48, colorVar: '--circle-a' },
  { name: 'Policy', cx: 81, cy: 48, colorVar: '--circle-b' },
  { name: 'Technology', cx: 66, cy: 78, colorVar: '--circle-c' },
];
const circles = CIRCLES.map((c) => ({ ...c, count: categoryCounts.get(c.name) ?? 0 })).filter(
  (c) => c.count > 0
);
---
<div class="category-venn">
  <svg viewBox="0 0 132 120" width="100%" role="img" aria-label="Post categories">
    {circles.map((c) => (
      <a href={`/category/${c.name.toLowerCase()}/`} class="venn-cat" aria-label={`${c.name} (${c.count})`}>
        <circle cx={c.cx} cy={c.cy} r="39" fill={`var(${c.colorVar})`} opacity="0.82" />
      </a>
    ))}
  </svg>
  <ul class="legend">
    {circles.map((c) => (
      <li>
        <a href={`/category/${c.name.toLowerCase()}/`}>
          <span class="swatch" style={`background: var(${c.colorVar})`}></span>
          {c.name}
        </a>
        <span class="count">{c.count}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .category-venn {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  svg {
    mix-blend-mode: multiply;
    max-width: 200px;
  }
  :global([data-theme='dark']) svg {
    mix-blend-mode: screen;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) svg {
      mix-blend-mode: screen;
    }
  }
  .venn-cat circle {
    transition: opacity 0.15s ease, transform 0.15s ease;
    transform-origin: center;
    transform-box: fill-box;
  }
  .venn-cat:hover circle,
  .venn-cat:focus-visible circle {
    opacity: 1;
    transform: scale(1.04);
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .legend a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .legend a:hover { color: var(--accent); }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
  }
  .count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
