---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Set on essay pages so search engines and link previews treat them as articles. */
  article?: { published: Date; categories: string[] };
}
const {
  title = 'The Vin Diagram',
  description = 'At the intersection of technology, investing, and policy.',
  image = '/og/default.png',
  article,
} = Astro.props;
const pageTitle = title === 'The Vin Diagram' ? title : `${title} – The Vin Diagram`;
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: imageUrl,
  datePublished: article.published.toISOString(),
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  author: { '@type': 'Person', name: 'Vinay Iyengar', url: new URL('/about/', Astro.site ?? Astro.url).href },
  publisher: { '@type': 'Person', name: 'Vinay Iyengar' },
};
---
<!doctype html>
<html lang="en">
<head>
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {}
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalUrl} />
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.categories.map((c) => <meta property="article:section" content={c} />)}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <meta property="og:site_name" content="The Vin Diagram" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <link rel="alternate" type="application/rss+xml" title="The Vin Diagram" href="/rss.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <Analytics />
</head>
<body>
  <Header />
  <main id="main" class="wrap">
    <slot />
  </main>
  <Footer />

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const el = document.getElementById('search');
      if (el && window.PagefindUI) {
        new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false });
      }
    });
  </script>
</body>
</html>
